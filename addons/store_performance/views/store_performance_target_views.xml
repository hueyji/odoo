<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_performance_target_tree" model="ir.ui.view">
        <field name="name">store.performance.target.tree</field>
        <field name="model">store.performance.target</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="company_id"/>
                <field name="period_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="target_amount"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_store_performance_target_form" model="ir.ui.view">
        <field name="name">store.performance.target.form</field>
        <field name="model">store.performance.target</field>
        <field name="arch" type="xml">
            <form string="业绩目标">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="company_id"/>
                    </group>
                    <group>
                        <field name="period_type"/>
                        <field name="period_start"/>
                        <field name="period_end" readonly="1"/>
                        <field name="target_amount"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_store_performance_target" model="ir.actions.act_window">
        <field name="name">业绩目标设置</field>
        <field name="res_model">store.performance.target</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
