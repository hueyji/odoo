<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="action_brand_core_health_check" model="ir.actions.server">
        <field name="name">品牌互通健康检查</field>
        <field name="model_id" ref="brand_core.model_store_link_group"/>
        <field name="state">code</field>
        <field name="code">
action = env["brand.core.health.service"].run_health_check()
        </field>
    </record>

    <menuitem
        id="menu_brand_core_health_check"
        name="配置健康检查"
        parent="brand_core.menu_brand_core_root"
        action="brand_core.action_brand_core_health_check"
        sequence="90"
        groups="brand_core.group_brand_platform_admin,brand_core.group_brand_portal_manager"
    />
</odoo>
