<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_brand_core" model="ir.module.category">
        <field name="name">品牌平台</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_brand_platform_admin" model="res.groups">
        <field name="name">品牌平台管理员</field>
        <field name="category_id" ref="brand_core.module_category_brand_core"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">可访问品牌平台全功能，含互通审批、门户配置。</field>
    </record>

    <record id="group_brand_portal_manager" model="res.groups">
        <field name="name">互通门户经理</field>
        <field name="category_id" ref="brand_core.module_category_brand_core"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
        <field name="comment">负责加盟门店与投资人门户的互通配置。</field>
    </record>
</odoo>
