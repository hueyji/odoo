<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="channel_cash_main_company" model="store.finance.channel">
        <field name="name">现金收款</field>
        <field name="code">CASH</field>
        <field name="channel_type">cash</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">1</field>
    </record>

    <record id="channel_stored_value_main_company" model="store.finance.channel">
        <field name="name">会员储值</field>
        <field name="code">STORED</field>
        <field name="channel_type">stored_value</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">5</field>
    </record>

    <record id="channel_pos_main_company" model="store.finance.channel">
        <field name="name">POS 刷卡</field>
        <field name="code">POS</field>
        <field name="channel_type">pos</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">10</field>
    </record>

    <record id="channel_third_party_main_company" model="store.finance.channel">
        <field name="name">第三方支付</field>
        <field name="code">THIRD</field>
        <field name="channel_type">third_party</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">15</field>
    </record>

    <record id="channel_internal_main_company" model="store.finance.channel">
        <field name="name">内部结算</field>
        <field name="code">INTERNAL</field>
        <field name="channel_type">internal</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">20</field>
        <field name="auto_reconcile">False</field>
    </record>
</odoo>
