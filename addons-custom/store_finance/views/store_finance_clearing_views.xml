<odoo>
    <data>
        <record id="view_store_finance_clearing_tree" model="ir.ui.view">
            <field name="name">store.finance.clearing.tree</field>
            <field name="model">store.finance.clearing</field>
            <field name="arch" type="xml">
                <tree string="互通清算" create="true">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="total_transaction_count"/>
                    <field name="total_amount_company_currency" widget="monetary"/>
                    <field name="state"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="view_store_finance_clearing_form" model="ir.ui.view">
            <field name="name">store.finance.clearing.form</field>
            <field name="model">store.finance.clearing</field>
            <field name="arch" type="xml">
                <form string="互通清算单">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,approved,cancelled"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_transaction_count" readonly="1"/>
                            <field name="total_amount_company_currency" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="清算明细">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="transaction_id"/>
                                        <field name="amount_currency" readonly="1"/>
                                        <field name="currency_id" readonly="1"/>
                                        <field name="amount_company_currency" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="备注">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_confirm" type="object" string="确认清算" class="btn-primary" states="draft"/>
                        <button name="action_approve" type="object" string="审核通过" class="btn-primary" states="confirmed"/>
                        <button name="action_cancel" type="object" string="取消清算" class="btn-secondary" states="confirmed,approved"/>
                        <button name="action_reset_to_draft" type="object" string="恢复草稿" class="btn-secondary" states="cancelled"/>
                        <button string="关闭" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_store_finance_clearing_search" model="ir.ui.view">
            <field name="name">store.finance.clearing.search</field>
            <field name="model">store.finance.clearing</field>
            <field name="arch" type="xml">
                <search string="互通清算搜索">
                    <field name="name"/>
                    <field name="state"/>
                    <filter string="本月" name="this_month" domain="[('date', '>=', context_today().replace(day=1))]"/>
                    <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="已确认" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <group expand="0" string="分组">
                        <filter string="按状态" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="按月份" name="group_month" context="{'group_by': 'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_store_finance_clearing" model="ir.actions.act_window">
            <field name="name">互通清算</field>
            <field name="res_model">store.finance.clearing</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
