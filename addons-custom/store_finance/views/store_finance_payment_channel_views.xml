<odoo>
    <data>
        <record id="view_store_finance_payment_channel_tree" model="ir.ui.view">
            <field name="name">store.finance.payment.channel.tree</field>
            <field name="model">store.finance.payment.channel</field>
            <field name="arch" type="xml">
                <tree string="支付渠道">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="journal_id"/>
                    <field name="account_id"/>
                    <field name="active"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="view_store_finance_payment_channel_form" model="ir.ui.view">
            <field name="name">store.finance.payment.channel.form</field>
            <field name="model">store.finance.payment.channel</field>
            <field name="arch" type="xml">
                <form string="支付渠道">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_store_finance_payment_channel" model="ir.actions.act_window">
            <field name="name">支付渠道</field>
            <field name="res_model">store.finance.payment.channel</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>

