<odoo>
    <data noupdate="1">
        <record id="group_store_finance_user" model="res.groups">
            <field name="name">财务流水用户</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="comment">访问门店财务流水与支付渠道配置的基础权限。</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="group_store_finance_manager" model="res.groups">
            <field name="name">财务流水经理</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="comment">维护科目映射、审批流水的高级权限。</field>
            <field name="implied_ids" eval="[(4, ref('store_finance.group_store_finance_user')), (4, ref('account.group_account_manager'))]"/>
        </record>
    </data>
</odoo>
