<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_store_performance_manager" model="res.groups">
            <field name="name">业绩看板 / 管理员</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('store_commission.group_store_commission_manager'))]"/>
        </record>

        <record id="group_store_performance_user" model="res.groups">
            <field name="name">业绩看板 / 员工</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('store_commission.group_store_commission_user'))]"/>
        </record>

        <record id="rule_store_performance_company" model="ir.rule">
            <field name="name">业绩记录公司隔离</field>
            <field name="model_id" ref="model_store_performance_record"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('store_performance.group_store_performance_user')), (4, ref('store_performance.group_store_performance_manager'))]"/>
        </record>
    </data>
</odoo>
