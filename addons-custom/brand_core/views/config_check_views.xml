<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_brand_config_check_list" model="ir.ui.view">
        <field name="name">brand.config.check.list</field>
        <field name="model">brand.config.check</field>
        <field name="arch" type="xml">
            <list string="配置检查记录">
                <field name="name"/>
                <field name="company_id"/>
                <field name="issue_count"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_brand_config_check_form" model="ir.ui.view">
        <field name="name">brand.config.check.form</field>
        <field name="model">brand.config.check</field>
        <field name="arch" type="xml">
            <form string="配置检查">
                <header>
                    <button name="action_run_checks"
                            string="执行检查"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id"/>
                            <field name="issue_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="检查结果">
                        <field name="issue_summary" readonly="1" widget="text"/>
                    </group>
                    <group string="消息记录">
                        <field name="message_ids" widget="mail_thread"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brand_config_check" model="ir.actions.act_window">
        <field name="name">配置检查</field>
        <field name="res_model">brand.config.check</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
