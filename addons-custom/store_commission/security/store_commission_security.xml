<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_store_commission_manager" model="res.groups">
            <field name="name">提成管理 / 管理员</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <record id="group_store_commission_user" model="res.groups">
            <field name="name">提成管理 / 门店用户</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="group_store_commission_auditor" model="res.groups">
            <field name="name">提成管理 / 审核员</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        </record>

        <record id="rule_store_commission_rule_company" model="ir.rule">
            <field name="name">提成规则公司隔离</field>
            <field name="model_id" ref="model_store_commission_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('store_commission.group_store_commission_user')), (4, ref('store_commission.group_store_commission_manager'))]"/>
        </record>

        <record id="rule_store_commission_log_company" model="ir.rule">
            <field name="name">提成日志公司隔离</field>
            <field name="model_id" ref="model_store_commission_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('store_commission.group_store_commission_user')), (4, ref('store_commission.group_store_commission_manager')), (4, ref('store_commission.group_store_commission_auditor'))]"/>
        </record>
    </data>
</odoo>
