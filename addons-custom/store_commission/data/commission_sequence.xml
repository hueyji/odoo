<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_store_commission_rule" model="ir.sequence">
            <field name="name">提成规则编号</field>
            <field name="code">store.commission.rule</field>
            <field name="prefix">TC%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_store_commission_log" model="ir.sequence">
            <field name="name">提成日志编号</field>
            <field name="code">store.commission.log</field>
            <field name="prefix">TJ%(y)s%(month)s</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
