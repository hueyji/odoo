<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_commission_rule_tree" model="ir.ui.view">
        <field name="name">store.commission.rule.tree</field>
        <field name="model">store.commission.rule</field>
        <field name="arch" type="xml">
            <list string="提成规则">
                <field name="code"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="rate_type"/>
                <field name="rate_value"/>
                <field name="scope_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_effective"/>
            </list>
        </field>
    </record>

    <record id="view_store_commission_rule_form" model="ir.ui.view">
        <field name="name">store.commission.rule.form</field>
        <field name="model">store.commission.rule</field>
        <field name="arch" type="xml">
            <form string="提成规则" create="true" edit="true">
                <header>
                    <button name="action_activate" type="object" string="生效" class="btn-primary"/>
                    <button name="action_reset_to_draft" type="object" string="重置为草稿"/>
                    <button name="action_archive" type="object" string="归档"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="请输入提成规则名称"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="rule_type"/>
                            <field name="scope_type"/>
                            <field name="rate_type"/>
                            <field name="rate_value"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="ladder_period"/>
                            <field name="version_code"/>
                            <field name="previous_rule_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="适用范围">
                            <group>
                                <field name="job_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="employee_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="商品匹配">
                            <group>
                                <field name="product_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="category_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="阶梯配置">
                            <field name="ladder_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="threshold_type"/>
                                    <field name="min_value"/>
                                    <field name="max_value"/>
                                    <field name="ladder_rate_type"/>
                                    <field name="ladder_rate_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="说明">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_store_commission_rules" model="ir.actions.act_window">
        <field name="name">提成规则</field>
        <field name="res_model">store.commission.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_is_effective": 1}</field>
    </record>
</odoo>
