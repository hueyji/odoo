<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_store_crowdfunding_dividend_list" model="ir.ui.view">
        <field name="name">store.crowdfunding.dividend.list</field>
        <field name="model">store.crowdfunding.dividend</field>
        <field name="arch" type="xml">
            <list string="分红计划" decoration-success="state == 'done'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="plan_date"/>
                <field name="amount_total" sum="计划总额"/>
                <field name="amount_paid" sum="已支付"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_store_crowdfunding_dividend_form" model="ir.ui.view">
        <field name="name">store.crowdfunding.dividend.form</field>
        <field name="model">store.crowdfunding.dividend</field>
        <field name="arch" type="xml">
            <form string="分红计划">
                <header>
                    <button name="action_confirm"
                            string="提交执行"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_execute"
                            string="执行分红"
                            type="object"
                            class="btn-success"
                            invisible="state != 'scheduled'"/>
                    <button name="action_cancel"
                            string="取消计划"
                            type="object"
                            class="btn-danger"
                            invisible="state in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="plan_date"/>
                            <field name="amount_total" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_paid" readonly="1"/>
                            <field name="description"/>
                            <field name="execution_note" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="分红明细">
                            <field name="line_ids" context="{'default_dividend_id': active_id, 'default_project_id': project_id}">
                                <list editable="bottom">
                                    <field name="investment_id" options="{'no_create': True}"/>
                                    <field name="partner_id" readonly="1"/>
                                    <field name="amount"/>
                                    <field name="amount_paid" readonly="1"/>
                                    <field name="is_paid" readonly="1"/>
                                    <field name="payout_transaction_id" readonly="1" options="{'no_open': False}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_store_crowdfunding_dividend_search" model="ir.ui.view">
        <field name="name">store.crowdfunding.dividend.search</field>
        <field name="model">store.crowdfunding.dividend</field>
        <field name="arch" type="xml">
            <search string="搜索分红计划">
                <field name="name"/>
                <field name="project_id"/>
                <field name="plan_date"/>
                <field name="state"/>
                <filter string="待执行" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <group expand="0" string="分组">
                    <filter name="group_by_project" string="按项目" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_state" string="按状态" context="{'group_by': 'state'}"/>
                    <filter name="group_by_plan_date" string="按月份" context="{'group_by': 'plan_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_store_crowdfunding_dividend" model="ir.actions.act_window">
        <field name="name">分红计划</field>
        <field name="res_model">store.crowdfunding.dividend</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_store_crowdfunding_dividend_search"/>
        <field name="help" type="html">
            <p>品牌方根据投资比例安排分红，执行后自动生成支出流水。</p>
            <p>支持在计划中维护多条分红明细，逐笔追踪支付完成情况。</p>
        </field>
    </record>
</odoo>
