<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_crowdfunding" name="我的众筹项目">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[(request.env.user.partner_id.name, '/my'), ('众筹项目', request.httprequest.full_path)]"/>
            <div class="o_portal_my_doc">
                <h1 class="mb-3">众筹项目</h1>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-subtitle text-muted mb-2">已确认认购总额</h6>
                                <div class="fs-4 text-primary">
                                    <t t-set="summary_currency" t-value="request.env.user.partner_id.member_balance_currency_id or request.env.company.currency_id"/>
                                    <t t-esc="format_amount(crowdfunding_investment_total or 0.0, summary_currency)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-subtitle text-muted mb-2">累计参与项目</h6>
                                <div class="fs-4 text-primary">
                                    <t t-esc="crowdfunding_investment_count or 0"/>
                                    <span class="ms-1">次</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h6 class="card-subtitle text-muted mb-2">最近参与日期</h6>
                                <div class="fs-4 text-primary">
                                    <t t-if="crowdfunding_last_investment_date">
                                        <t t-esc="crowdfunding_last_investment_date"/>
                                    </t>
                                    <t t-else="">暂无记录</t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <span class="badge bg-primary">总计：</span>
                        <span class="fw-bold"><t t-esc="len(projects)"/></span>
                        个项目
                    </div>
                    <div>
                        <label class="me-2">排序</label>
                        <select class="form-select d-inline-block w-auto"
                                onchange="location.href='?sortby=' + this.value">
                            <t t-foreach="searchbar_sortings.items()" t-as="sorting">
                                <option t-att-selected="sortby == sorting[0]" t-att-value="sorting[0]">
                                    <t t-esc="sorting[1]['label']"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>项目名称</th>
                            <th>发起门店</th>
                            <th class="text-end">目标金额</th>
                            <th class="text-end">已到账</th>
                            <th>进度</th>
                            <th class="text-end">我的投资</th>
                            <th>状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="not projects">
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    暂无可查看的众筹项目。
                                </td>
                            </tr>
                        </t>
                        <t t-foreach="projects" t-as="project">
                            <tr>
                                <td>
                                    <a t-att-href="f'/my/crowdfunding/{project.id}'">
                                        <t t-esc="project.display_name"/>
                                    </a>
                                </td>
                                <td><t t-esc="project.company_id.display_name"/></td>
                                <td class="text-end"><t t-esc="format_amount(project.target_amount, project.currency_id)"/></td>
                                <td class="text-end"><t t-esc="format_amount(project.amount_confirmed, project.currency_id)"/></td>
                                <td style="width: 160px;">
                                    <div class="progress">
                                        <div class="progress-bar"
                                             role="progressbar"
                                             t-att-style="'width: %s%%' % int(project.funding_progress)"
                                             t-att-aria-valuenow="int(project.funding_progress)"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                            <t t-esc="int(project.funding_progress)"/>%
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <t t-set="my_amount" t-value="investment_map.get(project.id, 0.0)"/>
                                    <t t-esc="format_amount(my_amount, project.currency_id)"/>
                                </td>
                                <td><span class="badge bg-secondary"><t t-esc="dict(project._fields['state'].selection).get(project.state)"/></span></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <t t-call="portal.portal_pager"/>
            </div>
        </t>
    </template>

    <template id="portal_crowdfunding_project" name="众筹项目详情">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs" t-value="[(request.env.user.partner_id.name, '/my'), ('众筹项目', '/my/crowdfunding'), (project.display_name, request.httprequest.full_path)]"/>
            <div class="o_portal_my_doc">
                <h1 class="mb-3"><t t-esc="project.display_name"/></h1>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">项目信息</h5>
                                <p class="card-text">
                                    <strong>发起门店：</strong>
                                    <t t-esc="project.company_id.display_name"/>
                                </p>
                                <p class="card-text">
                                    <strong>募集周期：</strong>
                                    <t t-esc="project.funding_start_date"/>
                                    至
                                    <t t-esc="project.funding_end_date or '未设置'"/>
                                </p>
                                <p class="card-text">
                                    <strong>目标金额：</strong>
                                    <t t-esc="format_amount(project.target_amount, project.currency_id)"/>
                                </p>
                                <p class="card-text">
                                    <strong>已到账：</strong>
                                    <t t-esc="format_amount(project.amount_confirmed, project.currency_id)"/>
                                </p>
                                <div class="mt-3">
                                    <span class="text-muted">进度</span>
                                    <div class="progress mt-2">
                                        <div class="progress-bar progress-bar-striped"
                                             role="progressbar"
                                             t-att-style="'width: %s%%' % int(project.funding_progress)"
                                             t-att-aria-valuenow="int(project.funding_progress)"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                            <t t-esc="int(project.funding_progress)"/>%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">我的投资</h5>
                                <t t-if="not investments">
                                    <p class="text-muted">暂无投资记录。</p>
                                </t>
                                <t t-else="">
                                    <ul class="list-group">
                                        <t t-foreach="investments" t-as="investment">
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="fw-bold"><t t-esc="investment.name"/></span>
                                                    <small class="d-block text-muted">
                                                        日期：
                                                        <t t-esc="investment.investment_date"/>
                                                    </small>
                                                    <small class="d-block text-muted">
                                                        状态：
                                                        <t t-esc="dict(investment._fields['state'].selection).get(investment.state)"/>
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <div>认购：<t t-esc="format_amount(investment.amount, investment.currency_id)"/></div>
                                                    <div>已确认：<t t-esc="format_amount(investment.amount_confirmed, investment.currency_id)"/></div>
                                                </div>
                                            </li>
                                        </t>
                                    </ul>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">项目详情</h5>
                        <div t-attf-class="o_portal_description">
                            <t t-if="project.description" t-raw="project.description"/>
                            <t t-else="">
                                <p class="text-muted">暂无详细介绍。</p>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">分红计划</h5>
                        <t t-if="not dividends">
                            <p class="text-muted">暂无分红计划。</p>
                        </t>
                        <t t-else="">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>计划编号</th>
                                        <th>执行日期</th>
                                        <th class="text-end">计划金额</th>
                                        <th class="text-end">已支付</th>
                                        <th>状态</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="dividends" t-as="dividend">
                                        <tr>
                                            <td><t t-esc="dividend.name"/></td>
                                            <td><t t-esc="dividend.plan_date"/></td>
                                            <td class="text-end"><t t-esc="format_amount(dividend.amount_total, dividend.currency_id)"/></td>
                                            <td class="text-end"><t t-esc="format_amount(dividend.amount_paid, dividend.currency_id)"/></td>
                                            <td><span class="badge bg-info"><t t-esc="dict(dividend._fields['state'].selection).get(dividend.state)"/></span></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
