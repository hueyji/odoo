<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_store_crowdfunding" model="ir.module.category">
            <field name="name">众筹管理</field>
            <field name="sequence">35</field>
        </record>

        <record id="group_store_crowdfunding_user" model="res.groups">
            <field name="name">众筹项目用户</field>
            <field name="category_id" ref="store_crowdfunding.module_category_store_crowdfunding"/>
            <field name="comment">可查看所属公司的众筹项目、投资与分红信息。</field>
        </record>

        <record id="group_store_crowdfunding_manager" model="res.groups">
            <field name="name">众筹项目经理</field>
            <field name="category_id" ref="store_crowdfunding.module_category_store_crowdfunding"/>
            <field name="implied_ids" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_user'))]"/>
            <field name="comment">负责众筹项目审核、执行、分红等全流程管理。</field>
        </record>

        <record id="rule_store_crowdfunding_project_user" model="ir.rule">
            <field name="name">众筹项目-所属公司可读</field>
            <field name="model_id" ref="model_store_crowdfunding_project"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_user'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_project_manager" model="ir.rule">
            <field name="name">众筹项目-经理全部权限</field>
            <field name="model_id" ref="model_store_crowdfunding_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_project_portal" model="ir.rule">
            <field name="name">众筹项目-门户可读</field>
            <field name="model_id" ref="model_store_crowdfunding_project"/>
            <field name="domain_force">
                [
                    ('portal_published', '=', True),
                    ('state', 'in', ['fundraising', 'in_progress', 'closed'])
                ]
            </field>
            <field name="groups" eval="[(4, ref('portal.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_investment_user" model="ir.rule">
            <field name="name">众筹投资-所属公司可读</field>
            <field name="model_id" ref="model_store_crowdfunding_investment"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_user'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_investment_manager" model="ir.rule">
            <field name="name">众筹投资-经理全部权限</field>
            <field name="model_id" ref="model_store_crowdfunding_investment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_investment_portal" model="ir.rule">
            <field name="name">众筹投资-门户本人</field>
            <field name="model_id" ref="model_store_crowdfunding_investment"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('portal.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_dividend_user" model="ir.rule">
            <field name="name">众筹分红-所属公司可读</field>
            <field name="model_id" ref="model_store_crowdfunding_dividend"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_user'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_dividend_manager" model="ir.rule">
            <field name="name">众筹分红-经理全部权限</field>
            <field name="model_id" ref="model_store_crowdfunding_dividend"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_dividend_payout_user" model="ir.rule">
            <field name="name">众筹分红明细-所属公司可读</field>
            <field name="model_id" ref="model_store_crowdfunding_dividend_payout"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_user'))]"/>
            <field name="perm_read" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_dividend_payout_manager" model="ir.rule">
            <field name="name">众筹分红明细-经理全部权限</field>
            <field name="model_id" ref="model_store_crowdfunding_dividend_payout"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('store_crowdfunding.group_store_crowdfunding_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_store_crowdfunding_dividend_payout_portal" model="ir.rule">
            <field name="name">众筹分红明细-门户本人</field>
            <field name="model_id" ref="model_store_crowdfunding_dividend_payout"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('portal.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
        </record>
    </data>
</odoo>
