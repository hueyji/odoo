<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="seq_store_inventory_batch" model="ir.sequence">
        <field name="name">库存批次编号</field>
        <field name="code">store.inventory.batch</field>
        <field name="prefix">BATCH%(y)s</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_store_inventory_move" model="ir.sequence">
        <field name="name">库存动作编号</field>
        <field name="code">store.inventory.move</field>
        <field name="prefix">MOVE%(y)s</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_store_inventory_transfer" model="ir.sequence">
        <field name="name">库存调拨编号</field>
        <field name="code">store.inventory.transfer</field>
        <field name="prefix">TRF%(y)s</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
