<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="store_inventory_company_branch_partner" model="res.partner">
            <field name="name">演示雪茄门店</field>
            <field name="company_type">company</field>
            <field name="street">湾区大道 88 号</field>
            <field name="phone">+1 415 555 0199</field>
            <field name="email">branch@brandstore.cn</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="store_inventory_company_branch" model="res.company">
            <field name="name">演示雪茄门店</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="parent_id" ref="base.main_company"/>
            <field name="partner_id" ref="store_inventory.store_inventory_company_branch_partner"/>
        </record>

        <record id="store_inventory_branch_warehouse" model="stock.warehouse">
            <field name="name">湾区旗舰仓</field>
            <field name="code">BAY</field>
            <field name="company_id" ref="store_inventory.store_inventory_company_branch"/>
            <field name="reception_steps">one_step</field>
            <field name="delivery_steps">ship_only</field>
        </record>
    </data>
</odoo>
