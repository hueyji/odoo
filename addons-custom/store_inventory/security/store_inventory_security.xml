<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_store_inventory_user" model="res.groups">
            <field name="name">库存操作员</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_store_inventory_manager" model="res.groups">
            <field name="name">库存负责人</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('store_inventory.group_store_inventory_user'))]"/>
        </record>

        <record id="rule_store_inventory_batch_user" model="ir.rule">
            <field name="name">store.inventory.batch user multi company</field>
            <field name="model_id" ref="model_store_inventory_batch"/>
            <field name="groups" eval="[(4, ref('store_inventory.group_store_inventory_user'))]"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        </record>

        <record id="rule_store_inventory_batch_system" model="ir.rule">
            <field name="name">store.inventory.batch system</field>
            <field name="model_id" ref="model_store_inventory_batch"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_store_inventory_operation_user" model="ir.rule">
            <field name="name">store.inventory.operation user</field>
            <field name="model_id" ref="model_store_inventory_operation"/>
            <field name="groups" eval="[(4, ref('store_inventory.group_store_inventory_user'))]"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        </record>

        <record id="rule_store_inventory_operation_system" model="ir.rule">
            <field name="name">store.inventory.operation system</field>
            <field name="model_id" ref="model_store_inventory_operation"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
