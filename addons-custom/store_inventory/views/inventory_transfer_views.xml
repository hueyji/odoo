<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_store_inventory_transfer_list" model="ir.ui.view">
        <field name="name">store.inventory.transfer.list</field>
        <field name="model">store.inventory.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="source_company_id"/>
                <field name="target_company_id"/>
                <field name="qty" sum="调拨数量"/>
                <field name="unit_price" optional="show"/>
                <field name="state"/>
                <field name="request_date" optional="show"/>
                <field name="completion_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_store_inventory_transfer_form" model="ir.ui.view">
        <field name="name">store.inventory.transfer.form</field>
        <field name="model">store.inventory.transfer</field>
        <field name="arch" type="xml">
            <form string="库存调拨">
                <header>
                    <button name="action_submit" type="object" string="提交审批" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="审批通过" class="btn-success" groups="stock.group_stock_manager" invisible="state != 'to_approve'"/>
                    <button name="action_reject" type="object" string="驳回" groups="stock.group_stock_manager" invisible="state != 'to_approve'"/>
                    <button name="action_reset_to_draft" type="object" string="回到草稿" groups="stock.group_stock_manager" invisible="state not in ['rejected', 'cancel']"/>
                    <button name="action_cancel" type="object" string="取消" class="btn-link" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,done,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_form_label"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="batch_id" options="{'no_create_edit': True}"/>
                            <field name="source_company_id" readonly="1"/>
                            <field name="target_company_id"/>
                            <field name="target_warehouse_id"/>
                            <field name="target_location_id"/>
                        </group>
                        <group>
                            <field name="qty"/>
                            <field name="unit_price"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="link_group_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="approver_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="note"/>
                    </group>
                    <notebook>
                        <page string="执行结果" invisible="state != 'done'">
                            <field name="out_move_id" options="{'no_create_edit': True}" readonly="1"/>
                            <field name="in_move_id" options="{'no_create_edit': True}" readonly="1"/>
                            <field name="new_batch_id" options="{'no_create_edit': True}" readonly="1"/>
                            <field name="completion_date" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_store_inventory_transfer_search" model="ir.ui.view">
        <field name="name">store.inventory.transfer.search</field>
        <field name="model">store.inventory.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="target_company_id"/>
                <filter string="待审批" name="transfer_to_approve" domain="[('state', '=', 'to_approve')]"/>
                <filter string="我的申请" name="transfer_my" domain="[('requester_id', '=', uid)]"/>
            </search>
        </field>
    </record>

    <record id="action_store_inventory_transfer" model="ir.actions.act_window">
        <field name="name">库存调拨</field>
        <field name="res_model">store.inventory.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_store_inventory_transfer_search"/>
    </record>
</odoo>
