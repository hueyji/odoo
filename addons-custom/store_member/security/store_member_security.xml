<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_member_sensitive" model="res.groups">
        <field name="name">会员敏感信息访问</field>
        <field name="comment">允许查看会员储值余额、互通组与投资画像等敏感字段。</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_member_export" model="res.groups">
        <field name="name">会员导出权限</field>
        <field name="comment">允许导出会员档案，自动附带敏感字段访问权限。</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_allow_export')), (4, ref('store_member.group_member_sensitive'))]"/>
    </record>

    <record id="brand_core.group_brand_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('store_member.group_member_sensitive')), (4, ref('store_member.group_member_export'))]"/>
    </record>

    <record id="brand_core.group_store_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('store_member.group_member_sensitive')), (4, ref('store_member.group_member_export'))]"/>
    </record>
</odoo>
