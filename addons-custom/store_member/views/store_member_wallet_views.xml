<odoo>
    <data>
        <record id="view_store_member_wallet_tree" model="ir.ui.view">
            <field name="name">store.member.wallet.tree</field>
            <field name="model">store.member.wallet</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="partner_id"/>
                    <field name="company_id"/>
                    <field name="balance_type"/>
                    <field name="balance"/>
                    <field name="sharing_scope"/>
                    <field name="allow_negative"/>
                    <field name="last_transaction_date"/>
                </tree>
            </field>
        </record>

        <record id="view_store_member_wallet_form" model="ir.ui.view">
            <field name="name">store.member.wallet.form</field>
            <field name="model">store.member.wallet</field>
            <field name="arch" type="xml">
                <form string="会员余额">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <field name="company_id"/>
                                <field name="balance_type"/>
                                <field name="currency_id"/>
                            </group>
                            <group>
                                <field name="balance" readonly="1"/>
                                <field name="sharing_scope"/>
                                <field name="allow_negative"/>
                                <field name="last_transaction_date" readonly="1"/>
                            </group>
                        </group>
                        <group string="变动日志">
                            <field name="log_ids" readonly="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="create_date"/>
                                    <field name="transaction_type"/>
                                    <field name="change_amount"/>
                                    <field name="balance_after"/>
                                    <field name="reference"/>
                                    <field name="actor_id"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_store_member_balance_log_tree" model="ir.ui.view">
            <field name="name">store.member.balance.log.tree</field>
            <field name="model">store.member.balance.log</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false" delete="false">
                    <field name="create_date"/>
                    <field name="partner_id"/>
                    <field name="wallet_id"/>
                    <field name="transaction_type"/>
                    <field name="change_amount"/>
                    <field name="balance_after"/>
                    <field name="reference"/>
                    <field name="actor_id"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="view_store_member_balance_log_form" model="ir.ui.view">
            <field name="name">store.member.balance.log.form</field>
            <field name="model">store.member.balance.log</field>
            <field name="arch" type="xml">
                <form string="余额变动记录">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <field name="wallet_id" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="transaction_type" readonly="1"/>
                                <field name="reference" readonly="1"/>
                            </group>
                            <group>
                                <field name="change_amount" readonly="1"/>
                                <field name="balance_after" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="actor_id" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="note" readonly="1"/>
                        </group>
                        <group>
                            <field name="trace_payload" readonly="1" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
