<odoo>
    <data>
        <record id="view_store_member_level_tree" model="ir.ui.view">
            <field name="name">store.member.level.tree</field>
            <field name="model">store.member.level</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="sequence"/>
                    <field name="threshold_amount"/>
                    <field name="benefit_note"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_store_member_level_form" model="ir.ui.view">
            <field name="name">store.member.level.form</field>
            <field name="model">store.member.level</field>
            <field name="arch" type="xml">
                <form string="会员等级">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="threshold_amount"/>
                                <field name="currency_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="benefit_note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
