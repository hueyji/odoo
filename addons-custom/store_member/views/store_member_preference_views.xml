<odoo>
    <data>
        <record id="view_store_member_preference_tree" model="ir.ui.view">
            <field name="name">store.member.preference.tree</field>
            <field name="model">store.member.preference</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="description"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_store_member_preference_form" model="ir.ui.view">
            <field name="name">store.member.preference.form</field>
            <field name="model">store.member.preference</field>
            <field name="arch" type="xml">
                <form string="偏好标签">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
