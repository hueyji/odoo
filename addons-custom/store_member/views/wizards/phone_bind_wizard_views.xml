<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_phone_bind_wizard_form" model="ir.ui.view">
        <field name="name">store.member.phone.bind.wizard.form</field>
        <field name="model">store.member.phone.bind.wizard</field>
        <field name="arch" type="xml">
            <form string="快速绑定手机号">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            class="btn btn-primary"
                            string="确认绑定"/>
                    <button string="取消" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
