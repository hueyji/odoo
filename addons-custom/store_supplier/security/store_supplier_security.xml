<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_store_supplier_user" model="res.groups">
            <field name="name">供应商专员</field>
            <field name="category_id" ref="base.module_category_inventory"/>
        </record>

        <record id="group_store_supplier_manager" model="res.groups">
            <field name="name">供应商主管</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="implied_ids" eval="[(4, ref('store_supplier.group_store_supplier_user'))]"/>
        </record>

        <record id="rule_store_supplier_user" model="ir.rule">
            <field name="name">store.supplier multi company</field>
            <field name="model_id" ref="model_store_supplier"/>
            <field name="groups" eval="[(4, ref('store_supplier.group_store_supplier_user'))]"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        </record>

        <record id="rule_store_supplier_system" model="ir.rule">
            <field name="name">store.supplier system</field>
            <field name="model_id" ref="model_store_supplier"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_store_supplier_report_user" model="ir.rule">
            <field name="name">store.supplier.purchase.report user</field>
            <field name="model_id" ref="model_store_supplier_purchase_report"/>
            <field name="groups" eval="[(4, ref('store_supplier.group_store_supplier_user'))]"/>
            <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        </record>
    </data>
</odoo>
