<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_store_supplier_list" model="ir.ui.view">
        <field name="name">store.supplier.list</field>
        <field name="model">store.supplier</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="rating"/>
                <field name="delivery_lead_days" optional="show"/>
                <field name="total_purchase_qty" sum="数量"/>
                <field name="total_purchase_amount" sum="金额"/>
                <field name="average_purchase_price" optional="show"/>
                <field name="purchase_order_count" optional="show"/>
                <field name="kpi_score"/>
                <field name="is_blacklisted" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_store_supplier_form" model="ir.ui.view">
        <field name="name">store.supplier.form</field>
        <field name="model">store.supplier</field>
        <field name="arch" type="xml">
            <form string="供应商档案">
                <header>
                    <button name="action_view_batches" type="object" string="查看批次" class="btn-secondary"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_batches" class="oe_stat_button" icon="fa-archive">
                            <field name="purchase_batch_ids" widget="statinfo" string="批次"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="company_id"/>
                            <field name="rating"/>
                            <field name="delivery_lead_days"/>
                        </group>
                        <group>
                            <field name="total_purchase_qty" readonly="1"/>
                            <field name="total_purchase_amount" readonly="1"/>
                            <field name="average_purchase_price" readonly="1"/>
                            <field name="purchase_order_count" readonly="1"/>
                            <field name="kpi_score" readonly="1"/>
                            <field name="is_blacklisted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="合作记录">
                            <field name="cooperation_note"/>
                        </page>
                        <page string="合同附件">
                            <field name="contract_attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="批次列表">
                            <field name="purchase_batch_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="qty_initial"/>
                                    <field name="qty_available"/>
                                    <field name="aging_stage_label"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_store_supplier_search" model="ir.ui.view">
        <field name="name">store.supplier.search</field>
        <field name="model">store.supplier</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <filter string="黑名单" name="filter_black" domain="[('is_blacklisted', '=', True)]"/>
                <group expand="0" string="评级">
                    <filter string="五星" domain="[('rating', '=', 'excellent')]"/>
                    <filter string="四星" domain="[('rating', '=', 'good')]"/>
                    <filter string="三星及以下" domain="[('rating', 'in', ['normal', 'warning', 'blocked'])]"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_store_supplier" model="ir.actions.act_window">
        <field name="name">供应商档案</field>
        <field name="res_model">store.supplier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_store_supplier_search"/>
    </record>

    <menuitem id="menu_store_supplier_root"
              name="供应商管理"
              parent="stock.menu_stock_root"
              action="action_store_supplier"
              sequence="40"
              groups="stock.group_stock_user,base.group_system"/>

    <record id="view_store_inventory_batch_form_supplier" model="ir.ui.view">
        <field name="name">store.inventory.batch.form.supplier</field>
        <field name="model">store.inventory.batch</field>
        <field name="inherit_id" ref="store_inventory.view_store_inventory_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='supplier_id']" position="after">
                <field name="supplier_record_id" options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
