<odoo>
    <data noupdate="1">
        <record id="seq_store_bar_table" model="ir.sequence">
            <field name="name">桌台编号</field>
            <field name="code">store.bar.table</field>
            <field name="prefix">TABLE%(y)s%(month)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_store_bar_order" model="ir.sequence">
            <field name="name">吧台订单</field>
            <field name="code">store.bar.order</field>
            <field name="prefix">BAR%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_store_bar_task" model="ir.sequence">
            <field name="name">调酒任务</field>
            <field name="code">store.bar.task</field>
            <field name="prefix">TASK%(y)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
