<odoo>
    <data noupdate="0">
        <record id="group_store_bar_manager" model="res.groups">
            <field name="name">吧台负责人</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_store_bar_bartender" model="res.groups">
            <field name="name">调酒师工作台</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_store_bar_user" model="res.groups">
            <field name="name">吧台前台员工</field>
            <field name="implied_ids" eval="[(4, ref('group_store_bar_bartender'))]"/>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
    </data>
</odoo>
