<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_store_combo_tree" model="ir.ui.view">
        <field name="name">store.combo.tree</field>
        <field name="model">store.combo</field>
        <field name="arch" type="xml">
            <tree string="套餐列表" default_order="name asc">
                <field name="name"/>
                <field name="list_price"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_store_combo_form" model="ir.ui.view">
        <field name="name">store.combo.form</field>
        <field name="model">store.combo</field>
        <field name="arch" type="xml">
            <form string="套餐">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="store_bar.group_bar_manager"/>
                        <field name="list_price"/>
                        <field name="currency_id" groups="store_bar.group_bar_manager"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="商品列表">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
