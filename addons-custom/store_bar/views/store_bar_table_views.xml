<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_store_bar_table_tree" model="ir.ui.view">
        <field name="name">store.bar.table.tree</field>
        <field name="model">store.bar.table</field>
        <field name="arch" type="xml">
            <tree string="桌台列表" default_order="name asc">
                <field name="name"/>
                <field name="company_id" groups="store_bar.group_bar_manager"/>
                <field name="state"/>
                <field name="capacity"/>
                <field name="reservation_partner_id"/>
                <field name="current_order_id"/>
                <field name="active" groups="store_bar.group_bar_manager"/>
            </tree>
        </field>
    </record>

    <record id="view_store_bar_table_form" model="ir.ui.view">
        <field name="name">store.bar.table.form</field>
        <field name="model">store.bar.table</field>
        <field name="arch" type="xml">
            <form string="桌台">
                <header>
                    <button name="action_mark_free" string="设为空闲" type="object" class="oe_highlight" attrs="{'invisible': [('state', '=', 'free')]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="action"
                            name="%(store_bar.action_store_bar_order)d"
                            icon="fa-list"
                        >
                            <field name="order_ids" widget="statinfo" string="历史订单"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="store_bar.group_bar_manager"/>
                        <field name="capacity"/>
                        <field name="active" groups="store_bar.group_bar_manager"/>
                        <field name="state" readonly="1"/>
                        <field name="current_order_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="reservation_partner_id"/>
                        <field name="reservation_phone"/>
                        <field name="reservation_datetime"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_store_bar_table" model="ir.actions.act_window">
        <field name="name">桌台</field>
        <field name="res_model">store.bar.table</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
